{
  "version": 1,
  "enabled": true,
  "preset": "default",
  "lines": [
    [
      {
        "id": "workspace",
        "type": "cwd",
        "enabled": true,
        "options": {
          "raw": true,
          "icon": "",
          "fg": "pi:accent",
          "bg": "default",
          "bold": true,
          "cwdDisplayStyle": "default",
          "segments": 3
        }
      },
      {
        "id": "branch",
        "type": "git-branch",
        "enabled": true,
        "options": {
          "raw": false,
          "hideWhenEmpty": true,
          "icon": "⎇ ",
          "text": "",
          "fg": "pi:success",
          "bg": "default",
          "bold": false,
          "gitBranchDisplayStyle": "default",
          "surroundLeft": "",
          "surroundRight": ""
        }
      },
      {
        "id": "git-status",
        "type": "git-status",
        "enabled": true,
        "options": {
          "raw": true,
          "hideWhenEmpty": true,
          "icon": "",
          "text": "",
          "fg": "pi:warning",
          "bg": "default",
          "bold": false
        }
      },
      {
        "id": "upstream",
        "type": "git-ahead-behind",
        "enabled": true,
        "options": {
          "raw": true,
          "hideWhenEmpty": true,
          "icon": "",
          "text": "",
          "fg": "pi:muted",
          "bg": "default",
          "bold": false
        }
      },
      {
        "id": "workspace-context-flex",
        "type": "flex-separator",
        "enabled": true,
        "options": {
          "fg": "default",
          "bg": "default",
          "bold": false,
          "hideWhenEmpty": true
        }
      },
      {
        "id": "context",
        "type": "context-bar",
        "enabled": true,
        "options": {
          "raw": true,
          "hideWhenEmpty": false,
          "icon": "",
          "text": "",
          "fg": "pi:accent",
          "bg": "default",
          "bold": false,
          "tokenFormatStyle": "compact",
          "contextBarMode": "short",
          "contextConditionalColors": true,
          "contextWarningPercent": 70,
          "contextDangerPercent": 90,
          "warningFg": "pi:warning",
          "warningBg": "default",
          "dangerFg": "pi:error",
          "dangerBg": "default"
        }
      }
    ],
    [
      {
        "id": "model",
        "type": "model-provider",
        "enabled": true,
        "options": {
          "raw": true,
          "icon": "",
          "fg": "pi:text",
          "bg": "default",
          "bold": false
        }
      },
      {
        "id": "thinking",
        "type": "thinking-level",
        "enabled": true,
        "options": {
          "raw": false,
          "hideWhenEmpty": true,
          "icon": "think:",
          "text": "",
          "fg": "pi:thinkingMedium",
          "bg": "default",
          "bold": false
        }
      },
      {
        "id": "session-name",
        "type": "session-name",
        "enabled": true,
        "options": {
          "raw": false,
          "hideWhenEmpty": true,
          "icon": "session:",
          "text": "-",
          "fg": "pi:muted",
          "bg": "default",
          "bold": false
        }
      },
      {
        "id": "model-metrics-flex",
        "type": "flex-separator",
        "enabled": true,
        "options": {
          "fg": "default",
          "bg": "default",
          "bold": false,
          "hideWhenEmpty": true
        }
      },
      {
        "id": "cache-hit",
        "type": "cache-hit-rate",
        "enabled": true,
        "options": {
          "raw": false,
          "hideWhenZero": true,
          "icon": "cache:",
          "fg": "pi:muted",
          "bg": "default",
          "bold": false,
          "cacheHitSource": "turn",
          "style": "compact"
        }
      },
      {
        "id": "cost",
        "type": "cost",
        "enabled": true,
        "options": {
          "raw": true,
          "icon": "",
          "fg": "pi:muted",
          "bg": "default",
          "bold": false,
          "costFormatStyle": "compact",
          "showSubscription": true
        }
      },
      {
        "id": "session-time",
        "type": "total-time",
        "enabled": true,
        "options": {
          "raw": false,
          "icon": "time:",
          "fg": "pi:dim",
          "bg": "default",
          "bold": false
        }
      }
    ]
  ],
  "separator": "dot",
  "separatorFg": "pi:warning",
  "separatorBg": "default",
  "iconMode": "nerd",
  "minimalist": false,
  "terminal": {
    "widthMode": "full",
    "colorLevel": "truecolor"
  },
  "extensionStatusRow": {
    "hiddenKeys": [],
    "knownKeys": [
      "bash-guard",
      "local-dictate"
    ]
  }
}
