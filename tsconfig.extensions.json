{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts"],
  "exclude": [
    "extensions/interactive-subagents/**",
    "extensions/observational-memory/**",
    "extensions/orca-*.ts",
    "**/node_modules/**"
  ]
}
